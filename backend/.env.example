DEEPTRACE_APP_NAME=DeepTrace PoC
DEEPTRACE_MAX_UPLOAD_MB=100
DEEPTRACE_FFPROBE_PATH=ffprobe
DEEPTRACE_FFMPEG_PATH=ffmpeg
DEEPTRACE_KEEP_UPLOADS=false
DEEPTRACE_UPLOAD_DIR=uploads
DEEPTRACE_REPORT_DB_PATH=data/deeptrace.db
DEEPTRACE_REPORT_MEDIA_DIR=data/report-media
DEEPTRACE_DATABASE_URL=sqlite:///data/workflow.db
# PostgreSQL for Docker Compose: postgresql+psycopg://deeptrace:deeptrace@postgres:5432/deeptrace
# Optional directory roles. The investigator account remains DEEPTRACE_EMPLOYEE_*.
# DEEPTRACE_REVIEWER_USERNAME=dps.reviewer
# DEEPTRACE_REVIEWER_PASSWORD=
# DEEPTRACE_ADMIN_USERNAME=dps.admin
# DEEPTRACE_ADMIN_PASSWORD=
# Case assistant. rules answers from the case record. gemini also receives the recording.
# DEEPTRACE_ASSISTANT_PROVIDER=gemini
# DEEPTRACE_GEMINI_API_KEY=
# DEEPTRACE_GEMINI_MODEL=gemini-2.5-flash
# DEEPTRACE_USE_MOCK_DETECTORS=false
# DEEPTRACE_STORAGE_BACKEND=local
# DEEPTRACE_S3_BUCKET=
DEEPTRACE_FRAME_INTERVAL_SECONDS=1.0
DEEPTRACE_MAX_FRAMES=120
DEEPTRACE_VISUAL_WEIGHT=0.5
# Model selection and commands: docs/models.md
# Leave commands empty until environments and checkpoints are installed.
DEEPTRACE_VIDEO_MODEL=efficientnetb4
# Portable default is default_0_5. Opt into the frozen development-selected face-only PoC rule:
# DEEPTRACE_EFFICIENTNET_DECISION_RULE=ffpp_c23_kaggle_v1
# This is any aligned frame >= 0.9967585206031799, not a calibrated probability or DPS acceptance.
DEEPTRACE_AUDIO_MODEL=aasist
# Original first-window scoring remains the portable default. Opt in to complete audio coverage:
# DEEPTRACE_AASIST_WINDOW_MODE=full
# Descriptive measurements, separate from model decisions (no calibrated artifact classifiers):
# DEEPTRACE_REVIEW_SIGNALS_COMMAND='.venv-models/bin/python scripts/inference/review_signals.py --media {media_path} --landmarks models/efficientnetb4/shape_predictor_81_face_landmarks.dat --max-seconds 30'
# DEEPTRACE_REVIEW_SIGNALS_TIMEOUT_SECONDS=300
# Overlap the two supplementary video checks with the primary detectors.
# DEEPTRACE_PARALLEL_REVIEW_CHECKS=false
# Sandbox mode refuses to start without configured auth; also restrict network access at deployment.
# DEEPTRACE_DEPLOYMENT_MODE=sandbox
DEEPTRACE_EXPLAIN=false
DEEPTRACE_EFFICIENTNET_COMMAND='.venv-models/bin/python scripts/inference/efficientnetb4.py --repo vendor/DeepfakeBench --weights models/efficientnetb4/effnb4_best.pth --landmarks models/efficientnetb4/shape_predictor_81_face_landmarks.dat --frames {frames_dir} --device cpu'
DEEPTRACE_AASIST_COMMAND='.venv-models/bin/python scripts/inference/aasist.py --repo vendor/aasist --weights models/aasist/AASIST.pth --audio {audio_path} --variant aasist --explain --device cpu'
# Whole-frame generated-image model, reported independently from the face model.
DEEPTRACE_SCENE_COMMAND='.venv-models/bin/python scripts/inference/commfor.py --weights models/commfor/frontier.safetensors --config models/commfor/config.json --revision 16db135220b318d811b207db576d90368980b595 --frames {frames_dir} --device cpu'
# Optional alternatives: video_model=effort or audio_model=nes2net
# DEEPTRACE_EFFORT_COMMAND=
# DEEPTRACE_NES2NET_COMMAND=

# Employee authentication is enabled for local development. Switch to Cognito in AWS.
DEEPTRACE_AUTH_ENABLED=true
DEEPTRACE_AUTH_MODE=employee
# Optional password-free local employee session; bind the API to loopback only.
# Never enable for a shared/public deployment. Disabled by default.
# DEEPTRACE_LOCAL_AUTO_LOGIN=false
DEEPTRACE_EMPLOYEE_USERNAME=dps.employee
DEEPTRACE_EMPLOYEE_PASSWORD=replace-with-a-strong-password
DEEPTRACE_SUPERVISOR_USERNAME=dps.supervisor
DEEPTRACE_SUPERVISOR_PASSWORD=replace-with-a-different-strong-password
DEEPTRACE_JWT_SECRET=replace-with-at-least-32-random-characters
DEEPTRACE_TOKEN_MINUTES=480
# DEEPTRACE_AWS_REGION=us-east-1
# DEEPTRACE_COGNITO_USER_POOL_ID=us-east-1_example
# DEEPTRACE_COGNITO_APP_CLIENT_ID=exampleclientid
# DEEPTRACE_COGNITO_DOMAIN=https://example.auth.us-east-1.amazoncognito.com
# DEEPTRACE_COGNITO_REDIRECT_URI=http://localhost:3000/

# Allowed browser origins (JSON array). Use your exact HTTPS frontend origin in AWS.
DEEPTRACE_FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]
# Optional PoC artifact paths; leave unset to preserve the portable three-detector profile.
# DEEPTRACE_GAN_ARTIFACT_COMMAND=".venv-models/bin/python scripts/inference/cnn_artifacts.py --repo vendor/CNNDetection --weights models/cnn_artifacts/blur_jpg_prob0.5.pth --frames {frames_dir} --device cpu"
# DEEPTRACE_VOCODER_ARTIFACT_COMMAND=".venv-models/bin/python scripts/inference/lfcc_lcnn.py --repo vendor/asvspoof2021 --weights models/lfcc_lcnn/df_trained_network.pt --audio {audio_path} --device cpu"
# DEEPTRACE_MICRO_EXPRESSION_COMMAND=".venv-models/bin/python scripts/inference/softnet.py --repo vendor/SoftNet-SpotME --weights models/softnet/CASME_micro_s1.hdf5 --landmarks vendor/SoftNet-SpotME/Utils/shape_predictor_68_face_landmarks.dat --media {media_path} --max-seconds 30"
