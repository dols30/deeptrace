/sign-in
DEEPTRACE_EMPLOYEE_USERNAME=dps.employee
DEEPTRACE_EMPLOYEE_PASSWORD=replace-with-a-strong-investigator-password
DEEPTRACE_SUPERVISOR_USERNAME=dps.supervisor
DEEPTRACE_SUPERVISOR_PASSWORD=replace-with-a-different-supervisor-password
DEEPTRACE_JWT_SECRET=replace-with-at-least-32-random-characters
DEEPTRACE_LOCAL_AUTO_LOGIN=false
DEEPTRACE_DEPLOYMENT_MODE=sandbox
DEEPTRACE_EXPLAIN=false

/url
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DEEPTRACE_FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

/compose
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
COMPOSE_PROJECT_NAME=deeptrace


/for GPU hosts
DEEPTRACE_TORCH_INDEX=cu126
DEEPTRACE_DEVICE=cuda
DEEPTRACE_MODEL_PROFILE=core
DEEPTRACE_MODEL_WORKERS=true
DEEPTRACE_MAX_PARALLEL_RUNNERS=4

/storage
DEEPTRACE_STORAGE_BACKEND=s3
DEEPTRACE_S3_BUCKET=replace-with-your-bucket-name
DEEPTRACE_S3_PREFIX=deeptrace
DEEPTRACE_AWS_REGION=us-east-1

/case-assistant
DEEPTRACE_ASSISTANT_PROVIDER=bedrock
DEEPTRACE_BEDROCK_REGION=us-east-1
DEEPTRACE_BEDROCK_ANSWER_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
DEEPTRACE_BEDROCK_VIDEO_MODEL=us.amazon.nova-lite-v1:0
