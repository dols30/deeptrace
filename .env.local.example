/sign-in
DEEPTRACE_EMPLOYEE_USERNAME=dps.employee
DEEPTRACE_EMPLOYEE_PASSWORD=replace-with-a-strong-investigator-password
DEEPTRACE_SUPERVISOR_USERNAME=dps.supervisor
DEEPTRACE_SUPERVISOR_PASSWORD=replace-with-a-different-supervisor-password
DEEPTRACE_JWT_SECRET=replace-with-at-least-32-random-characters
DEEPTRACE_LOCAL_AUTO_LOGIN=false
DEEPTRACE_DEPLOYMENT_MODE=local
DEEPTRACE_EXPLAIN=false

/url
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DEEPTRACE_FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

/host
DEEPTRACE_TORCH_INDEX=cpu
DEEPTRACE_DEVICE=cpu
DEEPTRACE_MODEL_PROFILE=core
DEEPTRACE_MODEL_WORKERS=false
DEEPTRACE_MAX_PARALLEL_RUNNERS=1

/storage
DEEPTRACE_STORAGE_BACKEND=local
DEEPTRACE_AWS_REGION=us-east-1

/case-assistant
DEEPTRACE_ASSISTANT_PROVIDER=rules
